# API Settings
VITE_API_PROTOCOL=http
VITE_API_HOST=localhost
VITE_API_PORT=5000

# <protocol>://<host>:<port>/<base-path>/ 
# <base-path>: api or tsts/api 
VITE_API_BASE_PATH=api

# App Settings
VITE_APP_PROTOCOL=http
VITE_APP_HOST=localhost
VITE_APP_PORT=3000

# <protocol>://<host>:<port>/<base-path>/ 
# <base-path>: tsts or <empty> for root
VITE_APP_BASE_PATH=

# Default Language
VITE_DEFAULT_LANGUAGE=en
